module mux2to1_8bit(select, in0, in1, out);
   input        select;
   input  [7:0] in0;
   input  [7:0] in1;
   output [7:0] out;
	
	assign out = (select == 1'b0) ? in0 :
	             (select == 1'b1) ? in1 : 8'bxxxxxxxx;

endmodule

